      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- last known value of each headline dataitem for this machine.\n-- the (VALUES (1)) base row guarantees exactly one row even when a lateral\n-- finds nothing, so the panel shows \"-\" instead of going empty.\nSELECT\n  a.value AS \"Availability\",\n  e.value AS \"Execution\",\n  m.value AS \"Mode\",\n  s.value AS \"E-Stop\",\n  p.value AS \"Program\",\n  c.value AS \"Part Count\"\nFROM (VALUES (1)) AS base(x)\nLEFT JOIN LATERAL get_last_value('$device/Availability', '7d')                  a ON true\nLEFT JOIN LATERAL get_last_value('$device/Controller/Path/Execution', '7d')     e ON true\nLEFT JOIN LATERAL get_last_value('$device/Controller/Path/ControllerMode', '7d') m ON true\nLEFT JOIN LATERAL get_last_value('$device/Controller/EmergencyStop', '7d')      s ON true\nLEFT JOIN LATERAL get_last_value('$device/Controller/Path/ProgramMain', '7d')   p ON true\nLEFT JOIN LATERAL get_last_value('$device/Controller/Path/PartCount', '7d')     c ON true",
          "refId": "A"
        }
      ],
      "title": "$device - Now",
      "type": "stat"
    },
