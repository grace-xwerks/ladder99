      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- path feedrate plus each axis feedrate.\n-- native units are MILLIMETER/SECOND, so x60 gives the mm/min a machinist reads.\nSELECT\n  time,\n  coalesce(substring(path, 'Axes/\\w+\\[(\\w+)\\]'), 'Path') AS axis,\n  value * 60                                                AS feedrate\nFROM history_float\nWHERE path LIKE '$device/%Feedrate%'\n  AND path NOT LIKE '%Override%'\n  AND $__timeFilter(\"time\")\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Feedrate",
      "type": "timeseries"
    },
