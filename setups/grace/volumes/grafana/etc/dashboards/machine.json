          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- axis and spindle load, in percent.\n-- where two LOAD dataitems share a component the relay disambiguates the path\n-- with the dataitem id, eg Axes/Rotary[C]/Load[Sload] - that is the spindle.\nSELECT\n  time,\n  CASE\n    WHEN path LIKE '%Load[Sload]' THEN 'Spindle'\n    ELSE coalesce(substring(path, 'Load\\[(\\w+)\\]$'),\n                  substring(path, 'Axes/\\w+\\[(\\w+)\\]/Load$'),\n                  path)\n  END   AS axis,\n  value AS load\nFROM history_float\nWHERE path LIKE '$device/Axes/%/Load%'\n  AND $__timeFilter(\"time\")\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Axis & Spindle Load",
      "type": "timeseries"
