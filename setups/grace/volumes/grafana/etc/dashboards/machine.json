          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- ROTARY_VELOCITY / ACTUAL, in rev/min.\nSELECT\n  time,\n  coalesce('Spindle ' || substring(path, 'Axes/\\w+\\[(\\w+)\\]'), 'Spindle') AS spindle,\n  value                                                                      AS speed\nFROM history_float\nWHERE path LIKE '$device/%RotaryVelocity%'\n  AND path NOT LIKE '%Override%'\n  AND $__timeFilter(\"time\")\nORDER BY time",
          "refId": "A"
