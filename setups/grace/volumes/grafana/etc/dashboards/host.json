      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- last known value of each host metric. history_float is used for the\n-- numbers so nothing has to be cast out of text.\nSELECT\n  a.value  AS \"Availability\",\n  cpu.value AS \"CPU\",\n  mem.value AS \"Memory Used\",\n  du.value  AS \"Disk Use\",\n  da.value  AS \"Disk Free\",\n  t.value   AS \"CPU Temp\"\nFROM (VALUES (1)) AS base(x)\nLEFT JOIN LATERAL get_last_value('$device/Availability', '7d') a ON true\nLEFT JOIN LATERAL (\n  SELECT value FROM history_float\n  WHERE path = '$device/CpuTotal' AND time > now() - interval '1 day'\n  ORDER BY time DESC LIMIT 1\n) cpu ON true\nLEFT JOIN LATERAL (\n  SELECT value FROM history_float\n  WHERE path = '$device/MemoryUsed' AND time > now() - interval '1 day'\n  ORDER BY time DESC LIMIT 1\n) mem ON true\nLEFT JOIN LATERAL (\n  SELECT value FROM history_float\n  WHERE path = '$device/DiskUse' AND time > now() - interval '1 day'\n  ORDER BY time DESC LIMIT 1\n) du ON true\nLEFT JOIN LATERAL (\n  SELECT value FROM history_float\n  WHERE path = '$device/DiskAvailable' AND time > now() - interval '1 day'\n  ORDER BY time DESC LIMIT 1\n) da ON true\nLEFT JOIN LATERAL (\n  SELECT value FROM history_float\n  WHERE path = '$device/Temperature' AND time > now() - interval '1 day'\n  ORDER BY time DESC LIMIT 1\n) t ON true",
          "refId": "A"
        }
      ],
      "title": "Host at a Glance",
      "type": "stat"
    },
